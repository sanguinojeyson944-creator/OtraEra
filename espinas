<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Escupidora de Espinas - Probador de IA y Habilidades</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0f172a;
      color: #f8fafc;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      min-height: 100vh;
    }
    h1 { margin-bottom: 10px; color: #a855f7; text-align: center; }
    p { margin-bottom: 15px; color: #94a3b8; text-align: center; }
    .main-container {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 1200px;
      width: 100%;
    }
    .canvas-card {
      background: #1e293b;
      border: 2px solid #334155;
      border-radius: 12px;
      padding: 15px;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    canvas {
      background: #050b14;
      border-radius: 8px;
      border: 1px solid #475569;
      cursor: crosshair;
    }
    .controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
      width: 100%;
    }
    button {
      background: #2563eb;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s;
    }
    button:hover { background: #1d4ed8; transform: translateY(-2px); }
    button.special { background: #9333ea; }
    button.special:hover { background: #7e22ce; }
    button.toxic { background: #059669; }
    button.toxic:hover { background: #047857; }
    .instructions {
      margin-top: 15px;
      font-size: 0.85rem;
      color: #cbd5e1;
      background: #0f172a;
      padding: 10px;
      border-radius: 6px;
      width: 100%;
    }
  </style>
</head>
<body>

  <h1>La Escupidora de Espinas (Enemigo 2/4)</h1>
  <p>Mueve el ratón sobre el área de juego para controlar al jugador y probar la IA y ataques.</p>

  <div class="main-container">
    <div class="canvas-card">
      <canvas id="gameCanvas" width="700" height="480"></canvas>
      <div class="controls">
        <button onclick="escupidora.dispararEspina(player)">1. Disparo Espina</button>
        <button onclick="escupidora.rafagaDoble(player)">2. Ráfaga Doble</button>
        <button class="special" onclick="escupidora.lluviaEspinas(player.x, player.y)">3. Lluvia de Espinas</button>
        <button class="toxic" onclick="escupidora.nubeToxica()">4. Nube Tóxica</button>
      </div>
      <div class="instructions">
        <strong>Comportamiento de IA:</strong><br>
        - Mantén la distancia: Si te acercas demasiado con el cursor, la criatura <em>retrocederá (Kiting)</em>.<br>
        - Activa el ataque 4 (Nube Tóxica) automáticamente si te pegas demasiado a ella.
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // Estado del Jugador (Sigue al cursor)
    const player = { x: 500, y: 240, radius: 12, color: '#38bdf8' };

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      player.x = e.clientX - rect.left;
      player.y = e.clientY - rect.top;
    });

    // Clase Principal: Escupidora de Espinas
    class EscupidoraEspinas {
      constructor(x, y) {
        this.x = x;
        this.y = y;
        this.radius = 28;
        this.angle = 0;
        this.projectiles = [];
        this.aoeZones = [];
        this.toxicClouds = [];
        this.cooldown = 0;
        this.legPhase = 0;
      }

      update(target) {
        if (this.cooldown > 0) this.cooldown--;
        this.legPhase += 0.05;

        // Orientación hacia el jugador
        const dx = target.x - this.x;
        const dy = target.y - this.y;
        const dist = Math.hypot(dx, dy);
        this.angle = Math.atan2(dy, dx);

        // IA de Retroceso (Kiting)
        if (dist < 160) {
          this.x -= Math.cos(this.angle) * 1.8;
          this.y -= Math.sin(this.angle) * 1.8;

          // Lanzar Nube Tóxica de emergencia si el jugador está encima
          if (dist < 70 && this.cooldown === 0) {
            this.nubeToxica();
          }
        }

        // Actualizar Proyectiles
        for (let i = this.projectiles.length - 1; i >= 0; i--) {
          const p = this.projectiles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.life--;
          if (p.life <= 0) this.projectiles.splice(i, 1);
        }

        // Actualizar AoE (Lluvia de Espinas)
        for (let i = this.aoeZones.length - 1; i >= 0; i--) {
          const zone = this.aoeZones[i];
          zone.timer--;
          if (zone.timer <= 0) this.aoeZones.splice(i, 1);
        }

        // Actualizar Nubes Tóxicas
        for (let i = this.toxicClouds.length - 1; i >= 0; i--) {
          const cloud = this.toxicClouds[i];
          cloud.radius += 1.5;
          cloud.alpha -= 0.015;
          if (cloud.alpha <= 0) this.toxicClouds.splice(i, 1);
        }
      }

      // HABILIDAD 1: Disparo Básico
      dispararEspina(target) {
        const dx = target.x - this.x;
        const dy = target.y - this.y;
        const angle = Math.atan2(dy, dx);
        this.projectiles.push({
          x: this.x + Math.cos(angle) * 20,
          y: this.y + Math.sin(angle) * 20,
          vx: Math.cos(angle) * 6.5,
          vy: Math.sin(angle) * 6.5,
          life: 90,
          color: '#10b981'
        });
      }

      // HABILIDAD 2: Ráfaga Doble
      rafagaDoble(target) {
        const dx = target.x - this.x;
        const dy = target.y - this.y;
        const baseAngle = Math.atan2(dy, dx);

        [-0.15, 0.15].forEach(offset => {
          const angle = baseAngle + offset;
          this.projectiles.push({
            x: this.x,
            y: this.y,
            vx: Math.cos(angle) * 7,
            vy: Math.sin(angle) * 7,
            life: 80,
            color: '#a855f7'
          });
        });
      }

      // HABILIDAD 3: Lluvia de Espinas
      lluviaEspinas(tx, ty) {
        this.aoeZones.push({ x: tx, y: ty, maxRadius: 50, timer: 75 });
      }

      // HABILIDAD 4: Nube Tóxica
      nubeToxica() {
        this.toxicClouds.push({ x: this.x, y: this.y, radius: 20, alpha: 0.8 });
        this.cooldown = 100;
      }

      draw(ctx) {
        // Dibujar Zonas AoE (Lluvia de Espinas)
        this.aoeZones.forEach(z => {
          ctx.strokeStyle = 'rgba(239, 68, 68, 0.8)';
          ctx.fillStyle = 'rgba(239, 68, 68, 0.2)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(z.x, z.y, z.maxRadius, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          // Marcador central
          ctx.fillStyle = '#ef4444';
          ctx.fillRect(z.x - 2, z.y - 10, 4, 20);
          ctx.fillRect(z.x - 10, z.y - 2, 20, 4);
        });

        // Dibujar Nubes Tóxicas
        this.toxicClouds.forEach(c => {
          ctx.fillStyle = `rgba(168, 85, 247, ${c.alpha})`;
          ctx.beginPath();
          ctx.arc(c.x, c.y, c.radius, 0, Math.PI * 2);
          ctx.fill();
        });

        // Patas de Raíz (4 Patas)
        ctx.strokeStyle = '#2e1065';
        ctx.lineWidth = 5;
        for (let i = 0; i < 4; i++) {
          const legAngle = this.angle + (i - 1.5) * 0.8;
          const legOffset = Math.sin(this.legPhase + i) * 6;
          ctx.beginPath();
          ctx.moveTo(this.x, this.y);
          ctx.lineTo(
            this.x + Math.cos(legAngle) * (35 + legOffset),
            this.y + Math.sin(legAngle) * (35 + legOffset)
          );
          ctx.stroke();
        }

        // Bulbo Central (Cuerpo)
        ctx.fillStyle = '#581c87';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();

        // Núcleo Luminoso Ámbar
        ctx.fillStyle = '#f59e0b';
        ctx.shadowColor = '#fbbf24';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(this.x, this.y, 12, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;

        // Proyectiles
        this.projectiles.forEach(p => {
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 6, 0, Math.PI * 2);
          ctx.fill();
        });
      }
    }

    const escupidora = new EscupidoraEspinas(200, 240);

    // Bucle Principal de Juego (Game Loop)
    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Fondo / Suelo
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Dibujar Jugador
      ctx.fillStyle = player.color;
      ctx.beginPath();
      ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
      ctx.fill();

      // Actualizar y Dibujar Escupidora
      escupidora.update(player);
      escupidora.draw(ctx);

      requestAnimationFrame(loop);
    }

    loop();
  </script>
</body>
</html>