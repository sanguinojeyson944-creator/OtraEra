    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        const stateDisplay = document.getElementById('stateDisplay');
        const playerStunDisplay = document.getElementById('playerStunDisplay');
        const slowMoToggle = document.getElementById('slowMoToggle');
        const hitboxToggle = document.getElementById('hitboxToggle');
        const aiToggle = document.getElementById('aiToggle');

        // Particles & Screen FX
        let particles = [];
        let screenShake = 0;

        // Duende Entity
        const duende = {
            x: 180,
            y: 280,
            state: 'idle', // idle, smash, dash, summon, rootStun
            phase: 'none',
            frame: 0,
            vx: 0,
            clubAngle: 0,
            spikes: [] // For ability 3
        };

        // Player Target Entity
        const playerTarget = {
            x: 520,
            y: 280,
            isStunned: false,
            stunTimeLeftMs: 0,
            vineGrowth: 0,
            shake: 0
        };

        let stunIntervalId = null;

        function resetPositions() {
            if (stunIntervalId) clearInterval(stunIntervalId);
            
            duende.x = 180;
            duende.state = 'idle';
            duende.phase = 'none';
            duende.frame = 0;
            duende.clubAngle = 0;
            duende.spikes = [];

            playerTarget.x = 520;
            playerTarget.isStunned = false;
            playerTarget.stunTimeLeftMs = 0;
            playerTarget.vineGrowth = 0;
            playerTarget.shake = 0;

            particles = [];
            updateUI();
        }

        function triggerSkill(type) {
            if (duende.state !== 'idle') return;
            
            duende.state = type;
            duende.phase = 'anticipation';
            duende.frame = 0;
            duende.spikes = [];
            updateUI();

            // Special Setup for Spike Summon (Sequential 1 by 1)
            if (type === 'summon') {
                const dir = playerTarget.x > duende.x ? 1 : -1;
                for (let i = 0; i < 3; i++) {
                    duende.spikes.push({
                        x: duende.x + (dir * (80 + i * 85)),
                        y: 285,
                        delay: i * 22, // Delayed 1 by 1 activation
                        frame: 0,
                        active: false,
                        erupted: false
                    });
                }
            }
        }

        function updateUI() {
            stateDisplay.innerText = duende.state.toUpperCase();
            
            if (playerTarget.isStunned) {
                const secs = (playerTarget.stunTimeLeftMs / 1000).toFixed(1);
                playerStunDisplay.innerText = `STUNNEADO (${secs}s