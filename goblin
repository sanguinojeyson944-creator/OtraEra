// CLASE ENTRADA ENEMIGO: DUENDE DEL LIQUEN (4 PODERES + IA)
// Origen: El Bosque Profundo de los Susurros
// ========================================================

class DuendeLiquen {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.hp = 120;
        this.maxHp = 120;
        
        // Estados: 'idle', 'smash', 'dash', 'summon', 'rootStun'
        this.state = 'idle';
        this.phase = 'none'; // 'anticipation', 'impact', 'recovery'
        this.frame = 0;
        
        // Cooldowns de Habilidades (ms)
        this.cooldowns = {
            smash: 0,
            dash: 0,
            summon: 0,
            rootStun: 0
        };
        
        // Espinas Secuenciales Array (Power #3)
        this.spikes = []; // Objetos: {x, y, active, timer, frame}
        
        // Atadura de Raiz (Power #4)
        this.isStunActive = false;
        this.stunTimer = 0;
    }

    // ----------------------------------------------------
    // LÓGICA DE INTELIGENCIA ARTIFICIAL (IA DE COMBATE)
    // ----------------------------------------------------
    updateAI(player, deltaTime) {
        // Actualizar cooldowns
        for (let key in this.cooldowns) {
            if (this.cooldowns[key] > 0) this.cooldowns[key] -= deltaTime;
        }

        if (this.state !== 'idle') return;

        const dist = Math.abs(player.x - this.x);

        // Prioridad 1: Atadura de Raíz si el jugador está lejos y la habilidad está lista
        if (dist > 200 && this.cooldowns.rootStun <= 0) {
            this.executeRootStun(player);
            this.cooldowns.rootStun = 10000; // 10s cooldown
            return;
        }

        // Prioridad 2: Invocación de Espinas Secuenciales (Rango Medio/Alto)
        if (dist > 180 && this.cooldowns.summon <= 0) {
            this.executeSpikeSummon(player);
            this.cooldowns.summon = 6000; // 6s cooldown
            return;
        }

        // Prioridad 3: Embestida de Raíces (Rango Medio)
        if (dist >= 90 && dist <= 200 && this.cooldowns.dash <= 0) {
            this.executeDashAttack();
            this.cooldowns.dash = 4500; // 4.5s cooldown
            return;
        }

        // Prioridad 4: Garrotazo Pesado (Rango Corto)
        if (dist < 90 && this.cooldowns.smash <= 0) {
            this.executeHeavySmash();
            this.cooldowns.smash = 3000; // 3s cooldown
            return;
        }

        // Movimiento básico de aproximación si no hay habilidades
        if (dist > 60) {
            this.x += (player.x > this.x ? 1 : -1) * 1.2;
        }
    }

    // ----------------------------------------------------
    // HABILIDAD 1: GARROTAZO PESADO
    // ----------------------------------------------------
    executeHeavySmash() {
        this.state = 'smash';
        this.phase = 'anticipation';
        this.frame = 0;
    }

    // ----------------------------------------------------
    // HABILIDAD 2: EMBESTIDA DE RAÍCES
    // ----------------------------------------------------
    executeDashAttack() {
        this.state = 'dash';
        this.phase = 'anticipation';
        this.frame = 0;
    }

    // ----------------------------------------------------
    // HABILIDAD 3: INVOCACIÓN DE ESPINAS (SECUENCIALES 1 A 1)
    // ----------------------------------------------------
    executeSpikeSummon(player) {
        this.state = 'summon';
        this.phase = 'anticipation';
        this.frame = 0;
        this.spikes = [];

        // Generar 3 espinas hacia la posición del jugador
        const dir = player.x > this.x ? 1 : -1;
        for (let i = 0; i < 3; i++) {
            this.spikes.push({
                x: this.x + (dir * (80 + i * 70)),
                y: 285,
                delay: i * 18, // Salen 1 por 1 cada 18 frames
                frame: 0,
                active: false,
                erupted: false
            });
        }
    }

    // ----------------------------------------------------
    // HABILIDAD 4: ATADURA DE RAÍZ (STUN 3 SEGUNDOS)
    // ----------------------------------------------------
    executeRootStun(player) {
        this.state = 'rootStun';
        this.phase = 'anticipation';
        this.frame = 0;
        this.targetPlayer = player;
    }
}</code></pre>
